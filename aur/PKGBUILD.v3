# Maintainer: Lumi <keoo2929@gmail.com>
pkgname=astralrinth-beta-v3-bin
pkgver=0.21.901.gf0f73ba4b3
pkgrel=1
pkgdesc='Unofficial Arch package of the AstralRinth beta Minecraft launcher (x86-64-v3, AVX2/FMA optimized)'
arch=('x86_64')
url='https://github.com/mozyk96/astralrinth-beta-build'
license=('GPL-3.0-only')
depends=(
  'alsa-lib'
  'cairo'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  # glibc >= 2.33 is required for x86-64-v3 ISA level support
  'glibc>=2.33'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsoup3'
  'openssl'
  'webkit2gtk-4.1'
  'xdg-utils'
)
makedepends=('libarchive' 'zstd')
optdepends=('java-runtime: run Minecraft instances')
provides=('astralrinth' 'astralrinth-beta-bin')
conflicts=('astralrinth' 'astralrinth-bin' 'astralrinth-app-bin' 'astralrinth-beta-bin')
source=("$pkgname-$pkgver-rootfs.tar.zst::https://github.com/mozyk96/astralrinth-beta-build/releases/download/v$pkgver/astralrinth-beta-v3-rootfs.tar.zst")
noextract=("$pkgname-$pkgver-rootfs.tar.zst")
sha256sums=('fe39d35952b7eb390dbdd74358d8c43a153f0d999a9816aa930b7c493d15c7df')

package() {
  # Runtime guard: reject installation on CPUs that do not support x86-64-v3.
  # This prevents SIGILL crashes on pre-Haswell Intel or pre-Zen2 AMD systems.
  if ! /usr/lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v3 (supported'; then
    printf 'ERROR: This package requires a CPU that supports the x86-64-v3 ISA level\n' >&2
    printf 'ERROR: (AVX, AVX2, FMA, BMI1, BMI2, F16C, MOVBE). Use astralrinth-beta-bin instead.\n' >&2
    return 1
  fi

  local archive="$srcdir/$pkgname-$pkgver-rootfs.tar.zst"
  [[ -s "$archive" ]] || {
    printf 'ERROR: release payload not found: %s\n' "$archive" >&2
    return 1
  }
  install -d "$pkgdir"
  bsdtar -xpf "$archive" -C "$pkgdir"

  # Compatibility symlinks for standard invocation
  ln -sf AstralRinthApp "$pkgdir/usr/bin/astralrinth"
  ln -sf AstralRinthApp "$pkgdir/usr/bin/astralrinth-beta"

  [[ -f "$pkgdir/usr/share/applications/astralrinth-beta.desktop" ]] || {
    printf 'ERROR: desktop entry missing from release payload.\n' >&2
    return 1
  }
  [[ -s "$pkgdir/usr/share/pixmaps/astralrinth-beta.png" || \
     -s "$pkgdir/usr/share/pixmaps/astralrinth-beta.svg" || \
     -s "$pkgdir/usr/share/pixmaps/astralrinth-beta.xpm" ]] || {
    printf 'ERROR: icon missing from release payload.\n' >&2
    return 1
  }
}
